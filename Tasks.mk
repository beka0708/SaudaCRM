# ============================================================
# saudacrm — TASKS (на основе ТЗ)
# Это не команды для запуска, а чек-лист задач по модулям.
# Смотри `make help`, дальше открывай нужный раздел и
# реализуешь пункт за пунктом (models -> admin -> services).
# ============================================================

help:
	@echo "Разделы задач (соответствуют ТЗ):"
	@echo "  catalog      - 1. Учёт товаров"
	@echo "  warehouse    - 2. Складской учёт"
	@echo "  sales        - 3. Продажи"
	@echo "  consignment  - 4. Учёт реализации"
	@echo "  debts        - 5. Учёт долгов"
	@echo "  clients      - 6. Клиенты"
	@echo "  finance      - 7. Финансы"
	@echo "  reports      - 8. Отчёты"
	@echo "  dashboard    - 9. Главный экран"
	@echo "  analytics    - 10. Аналитика"
	@echo "  roles        - Роли и права доступа"
	@echo "  bot          - Telegram-бот"
	@echo "  extra        - Дополнительные требования (кредит, партнёр, инвесторы, активы)"


# ------------------------------------------------------------
# 1. УЧЁТ ТОВАРОВ (apps/catalog)
# ------------------------------------------------------------
catalog:
	@echo "Модель Product: название, себестоимость, отпускная цена"
	@echo "Модель StockReceipt (приход): товар, дата, кол-во, дата поступления"
	@echo "Метод/свойство: текущий остаток товара (считается из движений склада)"
	@echo "Админка: список товаров с остатком, себестоимостью и ценой в одной таблице"


# ------------------------------------------------------------
# 2. СКЛАДСКОЙ УЧЁТ (apps/warehouse)
# ------------------------------------------------------------
warehouse:
	@echo "Модель StockMovement: товар, тип движения (приход/продажа/корректировка),"
	@echo "  количество, дата, комментарий"
	@echo "Сервис: пересчёт актуального остатка по товару (сумма движений)"
	@echo "Сервис: автоматическое списание при создании продажи (сигнал/вызов из sales)"
	@echo "Админка: история движений с фильтром по товару и типу"


# ------------------------------------------------------------
# 3. ПРОДАЖИ (apps/sales)
# ------------------------------------------------------------
sales:
	@echo "Модель Sale: дата, клиент, тип оплаты (нал/реализация/долг), сумма, комментарий"
	@echo "Модель SaleItem: продажа, товар, количество, цена на момент продажи"
	@echo "Логика: при типе 'долг' -> создать/обновить запись в apps/debts"
	@echo "Логика: при типе 'реализация' -> создать/обновить запись в apps/consignment"
	@echo "Логика: при любом типе -> списание товара со склада (warehouse.services)"
	@echo "Админка: форма продажи с добавлением нескольких товаров (inline)"


# ------------------------------------------------------------
# 4. УЧЁТ РЕАЛИЗАЦИИ (apps/consignment)
# ------------------------------------------------------------
consignment:
	@echo "Модель ConsignmentStock: клиент, товар, количество переданное, количество оплаченное"
	@echo "Логика: остаток товара у клиента = передано - оплачено/возвращено"
	@echo "Действие: 'зафиксировать оплату за реализованный товар' -> уменьшает остаток"
	@echo "Админка: список клиентов с товаром на реализации и текущим остатком"


# ------------------------------------------------------------
# 5. УЧЁТ ДОЛГОВ (apps/debts)
# ------------------------------------------------------------
debts:
	@echo "Модель Debt: клиент, сумма долга, дата возникновения, статус"
	@echo "Модель DebtPayment: долг, сумма оплаты, дата"
	@echo "Логика: после каждой оплаты — пересчёт остатка задолженности"
	@echo "Админка: реестр должников с сортировкой по сумме долга"


# ------------------------------------------------------------
# 6. КЛИЕНТЫ (apps/clients)
# ------------------------------------------------------------
clients:
	@echo "Модель Client: ФИО/название магазина, телефон, адрес"
	@echo "Свойства (derived): текущий долг, товар на реализации (из debts/consignment)"
	@echo "История операций: агрегация Sale + DebtPayment + ConsignmentStock по клиенту"
	@echo "Админка: карточка клиента со всеми связанными данными на одной странице"


# ------------------------------------------------------------
# 7. ФИНАНСЫ (apps/finance)
# ------------------------------------------------------------
finance:
	@echo "Модель CashFlow: тип (приход/расход), сумма, дата, категория, комментарий"
	@echo "Модель Expense: категория (доставка/аренда/закупка/др.), сумма, дата"
	@echo "Сервис: расчёт прибыли за период (приход - расход)"
	@echo "Сервис: расчёт текущей кассы (сумма всех приходов минус расходов)"
	@echo "Админка: фильтр по периоду для всех финансовых записей"


# ------------------------------------------------------------
# 8. ОТЧЁТЫ (apps/reports)
# ------------------------------------------------------------
reports:
	@echo "Отчёт: продажи за наличные (период)"
	@echo "Отчёт: продажи под реализацию (период)"
	@echo "Отчёт: продажи в долг (период)"
	@echo "Отчёт: поступления оплат (период)"
	@echo "Отчёт: расходы (период)"
	@echo "Отчёт: остатки на складе (на дату)"
	@echo "Отчёт: самые продаваемые товары (период)"
	@echo "Экспорт: генерация .xlsx для каждого отчёта (openpyxl)"


# ------------------------------------------------------------
# 9. ГЛАВНЫЙ ЭКРАН / ДАШБОРД (apps/analytics)
# ------------------------------------------------------------
dashboard:
	@echo "Виджет: общая стоимость товара на складе"
	@echo "Виджет: количество единиц товара на складе"
	@echo "Виджет: продажи за сегодня"
	@echo "Виджет: текущая касса"
	@echo "Виджет: сумма долгов клиентов"
	@echo "Виджет: сумма товара на реализации"
	@echo "Виджет: список товаров с низким остатком (порог настраиваемый)"


# ------------------------------------------------------------
# 10. АНАЛИТИКА (apps/analytics)
# ------------------------------------------------------------
analytics:
	@echo "ТОП продаваемых товаров: день / неделя / месяц / произвольный период"
	@echo "Медленно продаваемые товары (низкий спрос за период)"
	@echo "Кол-во проданных единиц и выручка по каждому товару"
	@echo "Сравнение продаж по периодам (текущий месяц vs предыдущий)"
	@echo "Прогноз запаса: остаток / средняя скорость продаж = дней хватит"
	@echo "Рейтинг самых прибыльных клиентов"
	@echo "Доля продаж по типам оплаты (нал/реализация/долг) - для графика"
	@echo "Маржинальность каждого товара: (цена - себестоимость) x кол-во продано"
	@echo "Графики на дашборде: выручка по дням, рейтинг товаров (Chart.js/аналог)"


# ------------------------------------------------------------
# РОЛИ И ПРАВА ДОСТУПА (apps/users + apps/core/permissions.py)
# ------------------------------------------------------------
roles:
	@echo "Роль 'администратор': полный доступ ко всем разделам"
	@echo "Роль 'продавец': доступ только к sales + clients (создание/просмотр)"
	@echo "Роль 'склад': доступ только к catalog + warehouse"
	@echo "Реализация: Django Groups + Permissions, либо кастомное поле role на User"
	@echo "Ограничение видимости в админке через has_module_permission / get_queryset"


# ------------------------------------------------------------
# TELEGRAM-БОТ (bot/)
# ------------------------------------------------------------
bot:
	@echo "Команда: учёт продажи (нал / под реализацию) -> вызывает sales.services"
	@echo "Команда: учёт расхода -> вызывает finance.services"
	@echo "Команда: оплата от должника -> вызывает debts.services"
	@echo "Команда: личный расход (например, Атай) -> отдельная категория в finance"
	@echo "Уведомление: товар заканчивается (порог остатка) -> сигнал из warehouse"
	@echo "Уведомление: поступила оплата от должника -> сигнал из debts"
	@echo "FSM (aiogram): пошаговый диалог для ввода суммы/товара/клиента"


# ------------------------------------------------------------
# ДОПОЛНИТЕЛЬНЫЕ ТРЕБОВАНИЯ (apps/finance, расширение)
# ------------------------------------------------------------
extra:
	@echo "Модель Loan: сумма кредита, платежи по кредиту, остаток задолженности"
	@echo "Модель PartnerDebt: учёт долга перед партнёром"
	@echo "Модель Investment: учёт денежных средств инвесторов"
	@echo "Модель OtherAsset: прочие активы (спецтехника, посевные площади и т.п.)"
	@echo "Модель TaxLiability: учёт остатка налоговых обязательств"


.PHONY: help catalog warehouse sales consignment debts clients finance reports dashboard analytics roles bot extra
