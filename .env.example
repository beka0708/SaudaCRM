# Шаблон переменных окружения. Скопируй в .env и заполни.
# .env в git не попадает (см. .gitignore).

# --- Django ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# На проде ОБЯЗАТЕЛЬНО False: иначе наружу утекают трассировки с настройками.
DEBUG=False

# IP сервера (домена нет). Через запятую, если адресов несколько.
ALLOWED_HOSTS=127.0.0.1,localhost
# Со схемой и портом — иначе админка не примет формы. Напр.:
# CSRF_TRUSTED_ORIGINS=http://203.0.113.10:8000
CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL ---
# DB_HOST в докере подставляется автоматически (db), локально — 127.0.0.1
DB_NAME=saudacrm
DB_USER=saudacrm
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Telegram-бот ---
BOT_TOKEN=

# --- Порт, на котором админка будет доступна снаружи ---
WEB_PORT=8000

# --- Утренний дайджест (время локальное, Asia/Bishkek) ---
DIGEST_HOUR=9
DIGEST_MINUTE=0

# --- Бэкапы ---
# ВАЖНО: комментарии только на отдельной строке. Этот файл читает и Makefile,
# и запись вида «BACKUP_HOUR=3  # час» превратит значение в «3  # час».

# час ежедневного дампа
BACKUP_HOUR=3
# сколько ежедневных копий хранить
DAILY_KEEP=30
# воскресных копий
WEEKLY_KEEP=12
# копий за 1-е число
MONTHLY_KEEP=12
